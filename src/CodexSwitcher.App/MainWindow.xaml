<Window x:Class="CodexSwitcher.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Switcher" Width="1260" Height="940" MinWidth="1020" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" Icon="Assets/Switcher.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid Background="{DynamicResource Canvas}">
  <Grid Margin="28,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Codex Switcher" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Text="Все аккаунты. Одна рабочая среда." Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,7,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Padding="18,3,0,3" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="В CODEX" FontSize="10" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/>
          <TextBlock x:Name="CurrentEmail" Text="Проверяю текущий вход…" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="CurrentHint" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Button x:Name="ThemeButton" Grid.Column="2" Click="ThemeClick" Style="{StaticResource LinkButton}" FontFamily="Segoe MDL2 Assets" FontSize="21" Width="42" Height="42" Margin="14,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="Переключить тему"/>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
      <StackPanel>
        <Grid x:Name="Cards">
          <Grid.ColumnDefinitions><ColumnDefinition/></Grid.ColumnDefinitions>
        </Grid>
        <Button x:Name="AddAccountButton" Content="+  Добавить аккаунт" Click="AddAccountClick" HorizontalAlignment="Left" Padding="18,10" Margin="0,4,0,12"/>
        <Border x:Name="RecoveryPanel" Visibility="Collapsed" Background="{DynamicResource RecoverySurface}" BorderBrush="{DynamicResource RecoveryLine}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,6,0,0">
          <StackPanel><TextBlock Text="Предыдущее переключение прервано. Сначала восстановите вход." TextWrapping="Wrap"/><Button Content="Восстановить предыдущий вход" Click="RecoveryClick" Margin="0,10,0,0" HorizontalAlignment="Left"/></StackPanel>
        </Border>
        <StackPanel Margin="0,6,0,0">
          <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}"/>
          <TextBlock x:Name="Status" Text="Подготовка…" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
          <Button x:Name="CancelLogin" Content="Отменить вход" Click="CancelClick" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,8,0,0"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Автообновление · 1 мин" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      <Button x:Name="RefreshButton" Grid.Column="1" Content="Обновить" Click="RefreshClick" MinHeight="34" Padding="14,7" Margin="0,0,8,0"/>
      <Button Grid.Column="2" Content="Инструкция" Click="HelpClick" MinHeight="34" Padding="14,7" Margin="0,0,8,0"/>
      <Button Grid.Column="3" Content="Выход" Click="ExitClick" Style="{StaticResource LinkButton}" Padding="10,7"/>
    </Grid>
  </Grid>
  </Grid>
</Window>

